    "hooks.terminal-cards": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer questions and permissions from terminal sessions in the notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在缺口中回答终端会话的提问和权限请求"
          }
        }
      }
    },
    "hooks.terminal-cards-explain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: sessions in Warp, Terminal, iTerm… show in the notch, but their questions and permission requests are asked in the terminal. On: the notch shows them first, and the terminal waits until you answer there or close the island (up to 2 min)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭：Warp、Terminal、iTerm… 等会话仍会显示在缺口中，但它们的提问和权限请求在终端里询问。开启：缺口优先显示它们，终端会一直等待，直到你在那里回答或关闭岛（最多 2 分钟）。"
          }
        }
      }
    },
    "statusline.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also wraps your statusline command, so the home card can show how much of a session's context is used. Removed together with the hooks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时会包装你的状态栏命令，让首页能显示会话已用掉多少上下文。卸载 Hooks 时一并移除。"
          }
        }
      }
    },
    "status.hooks-installed-no-statusline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks installed. Context usage is off — settings.json has no statusline command to wrap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks 已安装。上下文占用未启用——settings.json 里没有可包装的状态栏命令。"
          }
        }
      }
    },
