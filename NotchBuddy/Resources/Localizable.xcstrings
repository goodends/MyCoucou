    "These sessions are not shown in the list. Resume to re-monitor them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These sessions are not shown in the list. Resume to re-monitor them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些会话不在列表中。点 Resume 重新监控。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces sessions ne sont pas affichées dans la liste. Reprenez-les pour les surveiller de nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas sesiones no se muestran en la lista. Reanúdalas para volver a supervisarlas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الجلسات غير معروضة في القائمة. استأنفها لإعادة مراقبتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সেশনগুলো তালিকায় দেখানো হয় না। পুনরায় নিগরান করতে Resume করুন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये सत्र सूची में नहीं दिखाए जाते। उन्हें फिर से मॉनिटर करने के लिए Resume करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi ini tidak ditampilkan di daftar. Lanjutkan untuk memantau kembali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas sessões não aparecem na lista. Retome para monitorá-las novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти сеансы не показаны в списке. Возобновите их, чтобы снова следить за ними."
          }
        }
      }
    },
