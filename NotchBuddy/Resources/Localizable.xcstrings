    "hooks.codex.installed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخطافات مثبَّتة — افتح Codex ونفِّذ /hooks أو افتح Hooks في إعدادات التطبيق للموافقة عليها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হুক ইনস্টল হয়েছে — Codex খুলুন এবং /hooks চালান বা অ্যাপের সেটিংসে Hooks খুলুন বিশ্বাস করতে"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks installed — open Codex and run /hooks or open Hooks in app settings to approve them"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks instalados — abre Codex y ejecuta /hooks o abre Hooks en los ajustes de la app para confiar en ellos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks installés — ouvre Codex et lance /hooks ou ouvre Hooks dans les réglages de l'app pour les approuver"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हुक इंस्टॉल हो गए — Codex खोलें और /hooks चलाएं या उन्हें विश्वसनीय बनाने के लिए ऐप की सेटिंग में Hooks खोलें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks terpasang — buka Codex dan jalankan /hooks atau buka Hooks di pengaturan aplikasi untuk mempercayainya"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks instalados — abra o Codex e execute /hooks ou abra Hooks nas configurações do app para confiar neles"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуки установлены — открой Codex и выполни /hooks или открой Hooks в настройках приложения, чтобы подтвердить"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks 已安装 — 打开 Codex 并运行 /hooks，或在应用设置中打开 Hooks 以信任它们"
          }
        }
      }
    },
