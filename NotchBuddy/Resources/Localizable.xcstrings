    "chat.model.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدمه الدردشة. تأتي القائمة من حساب Anthropic الخاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চ্যাটে ব্যবহৃত হয়। তালিকা আপনার Anthropic অ্যাকাউন্ট থেকে আসে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used by the chat. The list comes from your Anthropic account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo usa el chat. La lista proviene de tu cuenta de Anthropic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé par le chat. La liste vient de ton compte Anthropic."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैट द्वारा उपयोग किया जाता है। सूची आपके Anthropic खाते से आती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan oleh chat. Daftar berasal dari akun Anthropic Anda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado pelo chat. A lista vem da sua conta Anthropic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется чатом. Список берётся из твоего аккаунта Anthropic."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由聊天使用。列表来自你的 Anthropic 账户。"
          }
        }
      }
    },
