    "No Orca projects found. Open one in Orca first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على مشاريع Orca. افتح مشروعًا في Orca أولاً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো Orca প্রকল্প পাওয়া যায়নি। প্রথমে Orca-তে একটি খুলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Orca projects found. Open one in Orca first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron proyectos de Orca. Abre primero uno en Orca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun projet Orca trouvé. Ouvrez d'abord un projet dans Orca."
