    "Nothing has finished yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ينتهِ أي شيء بعد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কিছু শেষ হয়নি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has finished yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no ha terminado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est encore terminé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कुछ समाप्त नहीं हुआ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang selesai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada terminou ainda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ничего не завершено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有任何会话完成。"
          }
