    "apps.explain-exclude": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ticked apps stay silent: no sessions in the list, no notifications, and their questions and permission requests are asked in the app itself. Every other app is shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选的应用保持安静：不展示会话、不发通知，它们的提问和权限请求在各自的应用里回答。其余应用全部展示。"
          }
        }
      }
    },
    "apps.other-note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions from an app we can't name land in Other."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认不出宿主的会话（比如启动时无法确定父进程的）都归到「其他应用」。"
          }
        }
      }
    },
