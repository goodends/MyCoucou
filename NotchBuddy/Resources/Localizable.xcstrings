    },
    "Sessions that finish will show up here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر هنا الجلسات المنتهية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেসব সেশন শেষ হবে সেগুলো এখানে দেখা যাবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions that finish will show up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones que terminen aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions qui se terminent apparaîtront ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो सत्र पूरे होंगे वे यहाँ दिखेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi yang selesai akan muncul di sini."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sessões que terminarem aparecerão aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершившиеся сессии появятся здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成的会话会出现在这里。"
          }
        }
      }
    },
