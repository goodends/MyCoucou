    "plugin.hermes.approvals": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض طلبات الموافقة في الشريط"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নচে অনুমোদন অনুরোধ দেখান"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show approval requests in the notch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar solicitudes de aprobación en el notch"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les demandes d'approbation dans le notch"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नॉच में अनुमोदन अनुरोध दिखाएं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan permintaan persetujuan di notch"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar solicitações de aprovação no notch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать запросы подтверждения в notch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在刘海中显示审批请求"
          }
        }
      }
    },
    "plugin.hermes.approvals.enabled": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر طلبات الموافقة في الشريط. إذا لم تكن MyCoucou تعمل، يعود Hermes إلى طرفيته الخاصة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নচে অনুমোদন অনুরোধ দেখানো হয়। MyCoucou না চললে Hermes তার নিজের প্রম্পটে ফলব্যাক করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval requests appear in the notch. If MyCoucou is not running, Hermes falls back to its own prompt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes de aprobación aparecen en el notch. Si MyCoucou no está en ejecución, Hermes usa su propio prompt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes d'approbation s'affichent dans le notch. Si MyCoucou ne tourne pas, Hermes utilise son propre prompt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नॉच में अनुमोदन अनुरोध दिखाए जाते हैं। यदि MyCoucou नहीं चल रहा तो Hermes अपने प्रॉम्प्ट पर वापस जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan persetujuan muncul di notch. Jika MyCoucou tidak berjalan, Hermes menggunakan promptnya sendiri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitações de aprovação aparecem no notch. Se MyCoucou não estiver em execução, Hermes usa seu próprio prompt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросы подтверждения отображаются в notch. Если MyCoucou не запущен, Hermes использует собственный prompt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批请求显示在刘海中。若 MyCoucou 未运行，Hermes 将回退到其自己的提示。"
          }
        }
      }
    },
