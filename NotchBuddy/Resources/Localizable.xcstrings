    "Give me a sec — back to work in three seconds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحظة — سأعود للعمل في ثلاث ثوانٍ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক সেকেন্ড — তিন সেকেন্ডে কাজে ফিরে যাচ্ছি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give me a sec — back to work in three seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dame un segundo — de vuelta al trabajo en tres segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seconde — de retour au travail dans trois secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पल — तीन सेकंड में वापस काम पर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu detik — kembali bekerja dalam tiga detik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um segundo — voltando ao trabalho em três segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Секунду — вернусь к работе через три секунды."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给我一秒钟——三秒后恢复工作。"
          }
        }
      }
    },
    "Gmail node timed out after 30s. Retry or open n8n.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة عقدة Gmail بعد 30 ثانية. أعد المحاولة أو افتح n8n."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail নোড 30 সেকেন্ড পরে টাইম আউট হয়েছে। পুনরায় চেষ্টা করুন বা n8n খুলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail node timed out after 30s. Retry or open n8n."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nodo de Gmail expiró después de 30s. Reintenta o abre n8n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nœud Gmail a expiré après 30s. Réessaie ou ouvre n8n."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail नोड 30 सेकंड बाद टाइम आउट हो गया। पुनः प्रयास करें या n8n खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Node Gmail habis waktu setelah 30 detik. Coba lagi atau buka n8n."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó do Gmail expirou após 30s. Tente novamente ou abra o n8n."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узел Gmail завершился по таймауту через 30с. Повторите или откройте n8n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmail 节点在 30 秒后超时。请重试或打开 n8n。"
          }
        }
      }
    },
    "Hide after": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء بعد"
          }
        },
        "bn": {
